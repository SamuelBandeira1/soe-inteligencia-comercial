# EXEMPLO — não usar em produção, copie e preencha no painel do Streamlit Cloud
# Este arquivo pode ser versionado (é só um exemplo sem dados reais)

# ── Google Drive — IDs dos arquivos parquet ───────────────────────────────────
# Como obter o ID:
#   1. Faça upload do .parquet no Google Drive
#   2. Clique com botão direito → Compartilhar → "Qualquer pessoa com o link"
#   3. O ID está na URL: drive.google.com/file/d/<ID_AQUI>/view
[gdrive]
vendas_id = "SEU_ID_DO_ARQUIVO_vendas_filtrada.parquet"
meta_id   = "SEU_ID_DO_ARQUIVO_meta_semanal.parquet"

# ── Usuários do sistema ───────────────────────────────────────────────────────
# Gere os hashes com: python -c "import bcrypt; print(bcrypt.hashpw(b'SENHA', bcrypt.gensalt(12)).decode())"
[users.comercial1]
email  = "comercial1@acocearense.com.br"
name   = "Comercial 1"
role   = "comercial"
hash   = "$2b$12$HASH_GERADO_AQUI"

[users.comercial2]
email  = "comercial2@acocearense.com.br"
name   = "Comercial 2"
role   = "comercial"
hash   = "$2b$12$HASH_GERADO_AQUI"

[users.planejamento]
email  = "planejamento@acocearense.com.br"
name   = "Planejamento"
role   = "planejamento"
hash   = "$2b$12$HASH_GERADO_AQUI"
